projection;
strict ( 2 );
use draft;

define behavior for zc_umpohead alias head
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _item { create; with draft; }
}

define behavior for zc_umpoitem alias item
{
  use update;
  use delete;

  use association _head { with draft; }
  use association _sche { create; with draft; }
}

define behavior for zc_umposche alias sche
{
  use update;
  use delete;

  use association _head { with draft; }
  use association _item { with draft; }
}